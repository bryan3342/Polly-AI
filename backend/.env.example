# Copy this file to `.env` and fill in real values. NEVER commit `.env` (it is gitignored).
# See docs/SETUP.md for how to obtain/generate each value.

# Google AI Studio API key for Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# SQLAlchemy database URL
DATABASE_URL=sqlite:///./debate_sessions.db
# App secret; generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

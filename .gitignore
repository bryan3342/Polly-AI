# Models fetched by scripts/fetch_models.py: the MediaPipe hand landmarker
# (~7.5 MB), YuNet face detection (~0.2 MB) and the FER+ emotion classifier
# (~35 MB). Binaries the code can fetch for itself.
backend/.models/

# The 175-image tuning pool for the emotion eval, fetched by
# backend/tests/eval/build_pool.py. The labels for it ARE committed
# (pool_labels.json); only the photographs are re-downloadable.
backend/tests/eval/pool/
backend/tests/eval/pool.json

# MediaPipe WASM runtime and models, staged into the frontend by
# scripts/stage-mediapipe.sh. ~30 MB copied from node_modules and downloaded
# from Google; nothing here is a source artifact.
frontend/public/mediapipe/

# The master recording, kept locally beside the compressed demo.mp4 that is
# actually served. Screen captures come out around 20 Mbps, which is ~10x what
# web playback needs and far past GitHub's 100 MB per-file limit. Safe to delete
# once you have the master somewhere else.
frontend/public/demo-original.mp4

# Built by deploy-landing.sh from frontend/public; regenerated on every run.
landing-dist/

# Wrangler local cache. Holds the Cloudflare account id and name; a local
# artifact, not a source one.
.wrangler/
